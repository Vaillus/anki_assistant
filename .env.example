# Copy to .env — .env is never committed.

# Required for the Chat tab. Without it the app runs, the chat is disabled.
ANTHROPIC_API_KEY=

# Optional: override the Claude model used by the chat.
ANKI_CHAT_MODEL=

# Optional: path to the deck -> sources mapping (default: ./sources.json).
ANKI_SOURCES=

# Optional: AnkiConnect URL (default http://localhost:8765).
ANKI_CONNECT_URL=
