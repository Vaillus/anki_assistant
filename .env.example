# Copy to .env — .env is never committed.

# Required for the Chat tab. Without it the app runs, the chat is disabled.
ANTHROPIC_API_KEY=

# Optional: override the Claude model used by the chat.
ANKI_CHAT_MODEL=

# Optional: path to the deck -> sources mapping (default: ./sources.json).
ANKI_SOURCES=

# Optional: AnkiConnect URL (default http://localhost:8765).
ANKI_CONNECT_URL=

# Optional: deck you study from in Anki. The priority queue uses its review
# budget to decide which due cards you'll actually see today.
STUDY_DECK=

# Optional: phone app (specs/mobile.md). Your Tailscale login; requests to
# the phone port are refused unless they carry it (unset: all refused).
MOBILE_OWNER_LOGIN=

# Optional: the phone port, the only one to `tailscale serve` (default 5071).
MOBILE_PORT=

# Optional: deck the phone reviews (default courant).
MOBILE_DECK=

# Optional: Anki's "next day starts at" hour (default 4).
ANKI_ROLLOVER_HOUR=
